<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SanteDB.Client.Mobile.RestartPage"
             xmlns:my="SanteDB.Client.Mobile"
             Title="App Restart Required" Padding="10,0">
    <VerticalStackLayout VerticalOptions="Center">
        <VerticalStackLayout>
            <Label 
                x:Name="TitleLabel"
                FontSize="Title"
                Text="App Restart Required"
                VerticalOptions="Center" 
                HorizontalOptions="Center" Margin="0,0,0,20" HorizontalTextAlignment="Center" /> 
            <Label
                x:Name="ContentLabel"
                FontSize="Body"
                Text="The App needs to be restarted. Click the Quit button below, and then re-launch the app."
                VerticalOptions="Center"
                HorizontalOptions="Center" HorizontalTextAlignment="Center" />
            <Button
                x:Name="QuitButton"
                Text="Quit"
                VerticalOptions="Center"
                HorizontalOptions="Center"
                Padding="50,10"
                Margin="20"
                FontSize="Large"
                Clicked="QuitButton_Clicked"/>
        </VerticalStackLayout>
    </VerticalStackLayout>
</ContentPage>