<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:sdb="clr-namespace:SanteDB.Client.Mobile.Controls"
             x:Class="SanteDB.Client.Mobile.MainPage">
    <Grid RowDefinitions="1*">
        <Border Grid.Row="0" StrokeThickness="0">
            <WebView x:Name="WebView"  />
        </Border>
        <sdb:NotificationBar x:Name="NotificationBar" Grid.Row="0" VerticalOptions="End" />
    </Grid>
</ContentPage>
