		<PackageReference Include="SQLitePCLRaw.provider.e_sqlite3mc" Version="2.1.9" Exclude="Build,Analyzers" />
		<PackageReference Include="SQLiteSpellfix.lib.e_sqlite3mc.android" Version="2.2.1" Exclude="Build,Analyzers" />
