	</ItemGroup>

	<ItemGroup>
	  <MauiXaml Update="Controls\NotificationBar.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="RestartPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
